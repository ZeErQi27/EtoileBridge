{
  "name": "etoilebridge-electron",
  "version": "1.2.26626",
  "private": true,
  "productName": "EtoileBridge",
  "description": "ArcCreate package toolkit",
  "main": "out/main/index.js",
  "scripts": {
    "worker:build": "gradlew.bat :converter-worker:installDist",
    "prepare:worker": "npm run worker:build && node scripts/prepare-worker.cjs",
    "prepare:runtime": "node scripts/prepare-runtime.cjs",
    "prepare:icon": "node scripts/prepare-icon.cjs",
    "dev": "npm run worker:build && electron-vite dev",
    "build": "npm run worker:build && electron-vite build",
    "dist:portable": "npm run build && npm run prepare:worker && npm run prepare:runtime && npm run prepare:icon && electron-builder --win portable",
    "dist:win": "npm run dist:portable",
    "start": "electron-vite preview",
    "smoke": "npm run worker:build && electron-vite build",
    "test:worker": "gradlew.bat :converter-worker:test"
  },
  "build": {
    "appId": "com.zeerqi27.etoilebridge",
    "productName": "EtoileBridge",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/runtime",
        "to": "runtime"
      },
      {
        "from": "converter-worker/build/install/converter-worker/lib",
        "to": "converter-worker/lib"
      },
      {
        "from": "src/renderer/src/assets/icon_windows.png",
        "to": "icon_windows.png"
      }
    ],
    "win": {
      "icon": "build/icon_windows.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "EtoileBridge-Windows-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^37.2.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "png-to-ico": "^3.0.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.6"
  }
}
